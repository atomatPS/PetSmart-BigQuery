SET opti_experiment_Control_US = '6529027226206208';
SET opti_experiment_Variant_US = '6529027226206208';
SET opti_experiment_Control_CA = '6529027226206208';
SET opti_experiment_Variant_CA = '6529027226206208';

SET Control_ID_US = '6544102091653120';
SET Variant_ID_US = '6725314210955264'; 
SET Control_ID_CA = '6544102091653120';
