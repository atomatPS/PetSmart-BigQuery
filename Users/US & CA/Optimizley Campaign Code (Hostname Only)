DECLARE opti_experiment_Variant_US STRING;
DECLARE opti_experiment_Control_CA STRING;
DECLARE opti_experiment_Variant_CA STRING;

DECLARE Control_ID_US STRING;
DECLARE Variant_ID_US STRING;
DECLARE Control_ID_CA STRING;
DECLARE Variant_ID_CA STRING;

