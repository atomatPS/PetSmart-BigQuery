DECLARE platform_cookie_Control_US STRING;
DECLARE platform_cookie_Variant_US STRING;

DECLARE opti_campaign_Control_US STRING;
DECLARE opti_campaign_Variant_US STRING;

DECLARE opti_experiment_Control_US STRING;
DECLARE opti_experiment_Variant_US STRING;

DECLARE Control_ID_US STRING;
DECLARE Variant_ID_US STRING;

