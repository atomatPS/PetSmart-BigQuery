## Notes:
#### Only edit what is in quotation marks --- do not leave anything blank
#### If any of these parameters are not needed --- then just put ".*"

SET platform_cookie_Control_CA = '.*'; 
SET platform_cookie_Variant_CA = '.*';

SET opti_campaign_Control_CA = '.*';
SET opti_campaign_Variant_CA = '.*';

SET opti_experiment_Control_CA = '28997890152';
SET opti_experiment_Variant_CA = '28997890152';

SET Control_ID_CA = '28985210197';
SET Variant_ID_CA = '29011170193';

SET Start_Date = '20250401';
SET End_Date = '20250401';

############################################################################################
############################################################################################


###############################
########### Variant ###########
###############################

SELECT 
COUNT(*) as Variant_n,
avg(CA_revenue) as Variant_Revenue_mean,
stddev(CA_revenue) as Variant_Revenue_sd,
avg(Conversion) as Variant_CVR_mean,
stddev(Conversion) as Variant_CVR_sd
from(
SELECT 
*, ROW_NUMBER() OVER(PARTITION BY CA_opti_user_id) as rn
from(
SELECT 
opti_user_id as CA_opti_user_id,
optimizely_variation as CA_optimizely_variation,
optimizely_experiment as CA_optimizely_experiment,
IFNULL(revenue,0) AS CA_revenue,
CASE WHEN revenue > 0 then 1 ELSE 0 END as Conversion
from(
with opti_users as (
 SELECT * 
  from(
    SELECT *,
    ROW_NUMBER() OVER(PARTITION BY opti_user_id) as rn
  from(
    SELECT 
    user_pseudo_id as opti_user_id,
    (SELECT value.string_value FROM UNNEST (event_params) WHERE key = 'edgio_cookie_experience') AS edgio_cookie_experience,
    (SELECT value.string_value FROM UNNEST (event_params) WHERE key = 'optimizely_variation') AS optimizely_variation,
    (SELECT value.string_value FROM UNNEST (event_params) WHERE key = 'optimizely_campaign') AS optimizely_campaign,
    (SELECT value.string_value FROM UNNEST (event_params) WHERE key = 'optimizely_experiment') AS optimizely_experiment
  from `petsmart-web-ecom.analytics_339409281.events_*` WHERE _TABLE_SUFFIX between Start_Date and End_Date AND  event_name = 'optimizely_decision_web'
  )
  WHERE regexp_contains(edgio_cookie_experience, platform_cookie_Variant_CA)
    AND regexp_contains(optimizely_campaign, opti_campaign_Variant_CA) 
    AND regexp_contains(optimizely_experiment, opti_experiment_Variant_CA)
    AND regexp_contains(optimizely_variation, Variant_ID_CA)  
  )
  WHERE rn = 1
),
purch_users as(
  SELECT 
  user_pseudo_id as purch_user_id,
  sum(ecommerce.purchase_revenue_in_usd) as revenue
  from `petsmart-web-ecom.analytics_339409281.events_*` WHERE _TABLE_SUFFIX between Start_Date and End_Date AND  event_name = 'purchase'
  group by 1
) 
SELECT * from opti_users 
left join purch_users on opti_user_id = purch_user_id
)  
)
) where rn = 1;

